# ============================================================
#  pcb2gcode - konfigurace pro tuhle frezku
# ============================================================
#
# Backend tenhle soubor predava pres --config, takze se meni na
# jednom miste a nemusi se sahat do kodu:
#
#   pcb2gcode --config .../webUI/printer/millproject \
#             --front <gerber> --output-dir <slozka> \
#             --front-output <jmeno>.gcode
#
# Co je tady, jsou vlastnosti STROJE. Co predava backend
# (--front, --output-dir, --front-output), je vlastnost JOBU.
#
# Vsechno nize jde volne prepsat argumentem na prikazove radce,
# CLI ma prednost pred timhle souborem.


# --- jednotky ---------------------------------------------------------
# metric      = rozmery v tomhle souboru jsou v mm
# metricoutput = vystupni G-kod je v mm
metric=true
metricoutput=true


# --- pocatek souradnic ------------------------------------------------
# zero-start posune desku tak, aby zacinala v (0,0) bez ohledu na to,
# kde lezela v PCB editoru. Bez tohohle by souradnice mohly vyjit
# zaporne a firmware zaporne X/Y clampne (error 6).
zero-start=true

# Jenze (0,0) stroje NENI pouzitelny bod - tam sedi koncaky Xmin a Ymin.
# Nejnizsi misto, kam se smi jet, je MINIMAL_DISTANCE_MM_X / _Y
# z nanoCode/src/main.cpp, tedy prave tam, kam odjede moveFromEndstops()
# po homingu. Offset posune celou desku o tenhle kus dal od dorazu.
#
#   x-offset = MINIMAL_DISTANCE_MM_X = 3
#   y-offset = MINIMAL_DISTANCE_MM_Y = 2
#
# Levy dolni roh desky tim padem lezi na (3, 2) a fyzicky ji tam je
# potreba i polozit. Zmena tehle dvou cisel se MUSI promitnout
# i do originOffsetX / originOffsetY v backend/server.js, jinak
# kontrola velikosti desky pusti vetsi kus, nez se vejde.
#
# UPINACI HACKY NA OKRAJICH  [ZATIM NEZAVEDENO, jen popis]
# Deska se drzi hacky po obvodu stolu, takze hrot na okraje nesmi -
# narazil by do nich. Reseni by bylo posunout desku doprostred
# pouzitelne plochy, coz je prave tenhle offset. Hodnoty nize se ale
# ZATIM NEMENI a zustavaji na 3 a 2 - centrovani neni vlastnost stroje,
# ale konkretni desky, takze patri do backendu k argumentum
# --x-offset / --y-offset, kde uz jsou rozmery zname z checkBoardFits().
# Tenhle odstavec je tady jen jako podklad, az na to dojde.
#
# Pouzitelny pas je ten, co si hlida checkBoardFits() v server.js -
# odsazeny o offset z OBOU stran, aby zbylo misto na hacky i na
# dalekem konci osy:
#
#   X od 3 do 57, tedy usableX = MAX_X - 2 * 3 = 54 mm
#   Y od 2 do 78, tedy usableY = MAX_Y - 2 * 2 = 76 mm
#
# Vycentrovana deska sirky W a vysky H tim padem patri na
#
#   x-offset = 3 + (54 - W) / 2
#   y-offset = 2 + (76 - H) / 2
#
# Rozmery desky vypise pcb2gcode do stdout a bere je i checkBoardFits()
# z hlavicky gerberu (radky "Width:" a "Height:").
#
# POZOR, mechanicka past: kdyz je deska uchycena JEN po obvodu a reze
# se doprostred, je pod hrotem nepodepreny rozpon. S V-bitem se kazde
# prohnuti desky primo prepise do sirky rezu (viz sekce o frezovani).
# Deska proto potrebuje podepreni i uprostred - nejlip oboustrannou
# paskou na rovnou obetovanou podlozku, ne jen hacky po krajich.
x-offset=3
y-offset=2


# --- osa Z ------------------------------------------------------------
# POZOR, tohle je nejdulezitejsi cast celeho souboru.
#
# pcb2gcode normalne pouziva zapornou Z pro rez (zwork=-0.05 znamena
# 0.05 mm pod povrch medi). Firmware ale Z clampuje do rozsahu
# 0 az MAX_Z (15 mm) a zaporne hodnoty srazi na 0 s errorem 6,
# takze by kazdy rezny pohyb sel po povrchu a nic by se nevyfrezovalo.
#
# Reseni: cely souradny system je posunuty nahoru. Z roste NAHORU,
# Z = 0 je doraz Zmin uplne dole. Povrch medi tedy neni Z=0.
#
# Hodnoty nize jsou ZMERENE na stroji, ne odhadnute:
#
#   Z = 10.00  bezpecna vyska pro rychloposuvy (zsafe)
#   Z =  1.60  rezne Z na X 3   (vysoky konec stolu)
#   Z =  1.10  rezne Z na X 57  (nizky konec, tady se sazi nastroj)
#   Z =  1.00  minimum po homingu na min (MINIMAL_DISTANCE_MM_Z)
#   Z =  0.90  podlaha clampZ, pod ni uz je error 6
#   Z =  0.00  doraz Zmin
#
# Povrch medi tedy NENI jedno cislo, ale rovina - stul klesa smerem k max X
# o 0.5 mm (zmereno 15. 8. 2026). V ose Y naklon neni, meren tehdy taky.
# Skutecne rezne Z drzi cutZAtXMax + tiltDrop v nanoComm, tenhle soubor
# o nem nerozhoduje.
#
# !!! DOLNI PODLAHA JE 0.9, NE 0.0 A NE 1.0 !!!
# clampZ() v nanoCode/src/main.cpp radek 832 dela tohle:
#     if (z < MINIMAL_DISTANCE_MM_Z - .1) { z = MINIMAL_DISTANCE_MM_Z - .1;
#                                           currentError = 6; }
# MINIMAL_DISTANCE_MM_Z je 1, takze se orezava pod 0.9. Zustava ale error 6
# - a ten v gcodeSender() v nanoComm spadne do vetve "return false", takze
# se JOB UKONCI uprostred rezu s hrotem v desce a bezicim vretenem.
#
# ODTUD PLYNE, PROC SE NASTROJ SAZI NA MAX X. Mezi minimem 1.0, o ktere se
# freza dorazi, a tou podlahou 0.9 je jen 0.1 mm - a korekce potrebuje
# celych 0.5 mm. Kdyby se nastroj sazel na X 3 (vysoky konec), lezel by
# anchor nahore a druhy konec by vysel na 1.1 - 0.5 = 0.6, tedy cela spodni
# polovina desky pres clamp a job pryc. Se sazenim na max X anchor lezi
# dole a korekce od nej uz jen stoupa: 1.10 na X 57 az 1.60 na X 3.
#
# Druhy duvod pro stejne misto: deska, o kterou se freza dorazi, je soucast
# toho nakloneneho stolu. Sazet pokazde jinde znamena dorazit o jinak vysoky
# bod a posunout nulu az o celych 0.5 mm.
#
# zchange je 12.0, tedy nad zsafe a porad pod MAX_Z 15.
#
# pcb2gcode na to vypise varovani "Engraving depth (--zwork) is
# greater than zero!" - to je v poradku a je to ocekavane.
#
# Stul byl 8. 8. 2026 vyrovnany mechanicky, ale dvoudenni test ukazal, ze
# to nestacilo. Korekce v nanoComm je proto od 15. 8. 2026 zase ZAPNUTA
# (tiltEnabled = true), prepocitana na spad + anchor misto dvou absolutnich
# hodnot a zvetsena z 0.15 na 0.5 mm. Viz poznamka 8.
#
# !!! zwork NENI skutecna hloubka rezu !!!
# Je to VYHRADNE znacka, podle ktere dekoder pozna rezny pohyb. Skutecnou
# hloubku nastavujes MECHANICKY - kolikrat kliknes krokem 0.1 nad minimum
# pri sazeni nastroje - a to cislo patri do cutZAtXMax v nanoComm.
# Snizovanim zwork se hloubka rezu NEZMENI, jen se rozejde znacka.
#
# gcodeCutZ v nanoComm/main.cpp musi porad sedet s timhle cislem.
# Dekoder podle nej pozna, ktery pohyb je rezny, a do kazdeho takoveho pak
# dosazuje Z z cutZForX(). Kdyz cisla prestanou sedet, dekoder rezne pohyby
# prestane poznavat a korekce se neprojevi vubec nikde.
zsafe=10.0
zwork=1.1
zchange=12.0


# --- frezovani --------------------------------------------------------
# mill-diameters = prumer hrotu ryciho nastroje v mm
# mill-feed      = posuv v rovine XY
# mill-vertfeed  = posuv pri zajezdu do materialu (pomalejsi)
# mill-speed     = otacky vretena, strop stroje je 20000
#
# !!! POZOR NA JEDNOTKY POSUVU !!!
# G-kod ma posuv v mm/MINUTU (hlavicka obsahuje G94), ale firmware
# pracuje s mm/SEKUNDU (MAX_SPEED 160 znamena 160 mm/s).
# mill-feed=200 tedy znamena 3.33 mm/s, ne 200 mm/s.
# Nekdo v ceste musi delit 60, viz poznamka na konci souboru.


# !!! mill-diameters=0.2 PLATI JEN PRO VALCOVOU FREZU !!!
# Merenim 15. 8. 2026 vyslo, ze rez neni 0.2 mm siroky:
#   - nejuzsi rucne udelana draha  ~0.4 mm
#   - pri vetsi hloubce            ~2.0 mm
# Valcova freza tohle udelat neumi, jeji sirka na hloubce nezavisi.
# Znamena to, ze v klestine sedi KUZELOVY ryci hrot (V-bit), kde plati
#
#   sirka = hrot + 2 * hloubka * tan(uhel / 2)
#
# tedy sirka rezu je primo funkce hloubky. To vysvetluje i tu 2mm ryhu:
# neni to vule ani hazivost, je to proste hlubsi zajezd do kuzele.
#
# Dusledek pro tenhle soubor: dokud tam je V-bit, je mill-diameters
# jenom cislo, ktere pcb2gcode pouzije na rozestup drah, a se skutecnou
# sirkou rezu nema nic spolecneho. Presnost izolace se pak nastavuje
# hloubkou (zwork + tilt), ne timhle parametrem.
#
# ZMERENI UHLU HROTU, aby se dalo pocitat dopredu: udelej dve zkusebni
# cary v odpadni casti desky na dvou znamych hloubkach (napr. rozdil
# 0.10 mm) a zmer sirky. Pak
#   tan(uhel / 2) = (sirka2 - sirka1) / (2 * (hloubka2 - hloubka1))
# Az bude uhel znamy, da se ze zadane sirky izolace spocitat hloubka.
mill-diameters=0.2

# mill-feed NESNIZUJ. Nizsi posuv tenhle stroj zhorsuje, ne zlepsuje:
# move2D pocita freqX = int(maxStepX / totalTime), coz je po dosazeni
#   freqX = 12.5 * rychlost * |dx| / delka_segmentu
# Cim mensi rychlost, tim casteji to spadne pod 1 a usekne se na nulu -
# a osa se pak vubec nerozjede. Viz poznamka 9.
# Druhy duvod je rezny: 200 mm/min pri 20000 ot/min a dvou britech je
# posuv na zub 0.005 mm. To uz je na hranici, kdy hrot prestava odebirat
# trisku a zacina med jenom hladit a tlacit pred sebou. Med se pak
# neustrihne, ale odtrhne od laminatu - a to je presne ten popsany
# "vytrhany" okraj.
mill-feed=200
mill-vertfeed=50
mill-speed=20000

# Sirka izolace. 0 = jediny prujezd kolem kazde cesty.
# Vetsi hodnota = vic prujezdu, sirsi odizolovani, delsi cas.
isolation-width=0
milling-overlap=50%


# --- co tenhle stroj nedela -------------------------------------------
# nog64 = negeneruj G64 (vyhlazovani drahy, umi to LinuxCNC, my ne)
# nom6  = negeneruj M6 (vymena nastroje, mame jen jeden hrot)
nog64=true
nom6=true


# --- optimalizace -----------------------------------------------------
# eulerian-paths zabrani frezovani stejne cesty dvakrat.
# Pozor: "optimise" ve verzi 2.5.0 uz NENI true/false, ale delka
# (povolena odchylka). V millproject_example, co je pribaleny
# ke zdrojakum, je jeste stara boolean varianta a rozbije parsovani.
#
# optimise=0.04mm NENI kosmetika, je to shoda s rozlisenim stroje.
# Firmware pocita kroky takhle (move2D):
#     maxStepX = abs(stepLenghtGT2 * lenghtX)     // int, orizne se
# stepLenghtGT2 je 12.5 kroku/mm, jeden krok je tedy 0.08 mm. Kratsi
# pohyb na ose vyjde po oriznuti jako NULA kroku a "if (freqX != 0)"
# tu osu rovnou preskoci. Zbytek se navic zahodi, protoze
# myToolHead.position dostane cilovou souradnici, ne ujetou.
#
# Vychozi tolerance pcb2gcode je 0.00254 mm, tedy 31x jemnejsi nez
# jeden krok - generuje detail, ktery stroj neumi ujet. Zmereno na
# testGerber/smiley.GTL, pocet segmentu s aspon jednou mrtvou osou:
#
#     0.00254 mm (vychozi)  222 pohybu, 38 % degradovanych, 29 uplne mrtvych
#     0.02 mm               174 pohybu, 16 %,                 0 uplne mrtvych
#     0.04 mm               142 pohybu,  8 %,                 0 uplne mrtvych
#     0.08 mm               120 pohybu,  4 %,                 0 uplne mrtvych
#
# 0.04 mm je pulka kroku: odchylka zustane pod rozlisenim stroje
# a "uplne mrtve" pohyby (nehne se nic, prikaz jen zabere cas
# a jeden report) zmizi uplne. Vic uz kazi geometrii viditelne.
optimise=0.04mm
eulerian-paths=true
tsp-2opt=true


# ======================================================================
#  POZNAMKY K INTEGRACI - precist pred prvnim ostrym behem
# ======================================================================
#
# 1) POSUV JE V mm/min, FIRMWARE CHCE mm/s  [VYRESENO]
#    Radek "G01 F200" znamena 200 mm/min = 3.33 mm/s. Deli se
#    sesdesati v createCMD() v nanoComm, u znaku 'F':
#        cmd.speed = number / 60;
#    Deleni patri PRAVE SEM a nikam jinam. Nesmi byt
#    v prepareForNano(), protoze ta lezi na spolecne ceste pro
#    vsechny prikazy vcetne rucniho jogu z frontendu - a ten uz
#    posila mm/s. Tam by stroj rucne jezdil 60x pomaleji.
#    Umisteni v createCMD() navic nechava na pokoji sentinel
#    speed = -1, protoze funkce se vola jen kdyz znak F opravdu byl.
#
# 2) KONEC PROGRAMU JE M2, NE M30  [VYRESENO]
#    pcb2gcode uzavira soubor prikazem M2. determineCMD() v nanoComm
#    dnes bere oboji:
#        else if (curNum == 2 || curNum == 30) { return 7; }
#
# 3) HLAVICKA OBSAHUJE KODY, KTERE DEKODÉR NEZNA
#    Konkretne G94, G21, G90, G04, T0, M0, M9, M2. Vsechny spadnou
#    do "Unsupported command" a preskoci se, takze to nic nerozbije,
#    jen to zaplni log. Pohybove prikazy jsou jen G00 a G01.
#
# 4) ZADNE OBLOUKY
#    Overeno na realnem vystupu: pcb2gcode negeneruje G2/G3, jen
#    G00 a G01. Pole I a J v instructionChars zustanou nevyuzita.
#
# 5) VELIKOST DESKY  [VYRESENO]
#    Stroj ma MAX_X 60 x MAX_Y 80 mm, ale to je vzdalenost mezi
#    koncaky, ne pouzitelna plocha. Odsazeni se odecita na OBOU
#    stranach - zacatek je na offsetu a konec musi zustat stejny
#    kus pred protejsim dorazem:
#
#      X:  60 - 2*3 = 54 mm
#      Y:  80 - 2*2 = 76 mm
#
#    pcb2gcode pri exportu vypise rozmery ("Height: ... Width: ..."),
#    backend je cte v checkBoardFits() a vetsi desku zastavi jeste
#    pred odeslanim do Nana.
#
# 6) OTACKY VRETENA JSOU V CELE ULOZE JEDNO CISLO  [VYRESENO]
#    mill-speed=20000 se objevi jednou v hlavicce jako "S20000"
#    a uz se nemeni. V Nanu to vyjde na stridu presne 255, takze
#    controlSpindl() udela digitalWrite(HIGH) a PWM pri frezovani
#    vubec nebezi. Snizeni mill-speed treba na 19000 da stridu 242
#    a PWM se zapne i s pripadnym pistenim.
#
#    Pozor na navaznost: pcb2gcode vlozi za hlavicku blok vymeny
#    nastroje "T0 / M5 / M0 / M3", kde M5 vreteno vypne a M3 uz prijde
#    BEZ S. Dekoder proto posledni videne S drzi v lastSpindleSpeed
#    a na M3 ho dosadi zpatky - jinak by vreteno po prvnich par set
#    milisekundach zhaslo a cely job by se frezoval nastojato.
#    Ten blok z pcb2gcode vypnout nejde, nom6 potlaci jen M6.
#
# 7) PREJEZDY V REZNE HLOUBCE  [NEVYRESENO, POZOR PRI OSTREM BEHU]
#    pcb2gcode obcas spoji dve samostatne izolacni smycky primym
#    G01 v hloubce zwork misto toho, aby zvedl na zsafe a prejel
#    rychloposuvem. Na smiley.GTL jsou takove pohyby ctyri, nejdelsi
#    ma 15.5 mm, a vedou pres mista, kde se rezat nema.
#
#    Neni to nastavenim tohohle souboru. Overeno na:
#      eulerian-paths=false            4 -> 3 pohyby, ten 15.5 mm zustal
#      eulerian-paths+tsp-2opt=false   3 pohyby, zustal
#      path-finding-limit=30           4 pohyby, zustal
#      isolation-width=0.4 i 0.6       zustal (jen jinak dlouhy)
#      optimise 0.00254 az 0.08 mm     zustal
#
#    NA SUCHO (bez desky) je to neskodne. NA DESCE to znamena rylo
#    tazene skrz med tam, kde ma zustat spoj. Pred prvnim ostrym
#    behem je potreba bud najit spravny prepinac v pcb2gcode, nebo
#    si ty prejezdy odchytit v backendu a rozdelit je na
#    zvednuti / rychloposuv / zajezd.
#
# 8) KOMPENZACE NAKLONU STOLU  [ZAPNUTA, SPAD + ANCHOR]
#    Mechanicke vyrovnani z 8. 8. 2026 zbytkovy naklon neodstranilo.
#    Test 13. - 15. 8. 2026 ukazal, ze korekce potreba je, a ze byla
#    3x mensi, nez ma byt: mela rozpeti 0.15 mm, skutecny spad je 0.5 mm
#    pres celou drahu X. V ose Y naklon zmeren nebyl zadny.
#
#    !!! PRIZNAK "NA MAX X TO NEREZE" NEROZLISI SPATNE ZNAMENKO
#    !!! OD MOC MALEHO ROZPETI. Oboji vypada uplne stejne. Behem testu
#    !!! se kvuli tomu ta dve cisla jednou zbytecne prohodila. Jedina
#    !!! kontrola je dotek na obou koncich pri tiltEnabled = false.
#
#    ZMERENY STAV (15. 8. 2026): stul KLESA smerem k max X o 0.5 mm.
#    Na X 3 je nejvys, na X 57 nejniz - tam hrot planda ve vzduchu.
#
#    Korekce se proto od 15. 8. 2026 nezadava dvema absolutnimi Z, ale
#    spadem a anchorem, protoze absolutni cisla neresila, ze anchor musi
#    lezet na tom konci, kde se sazi nastroj:
#        float tiltDrop    = 0.50f;   // o kolik stul klesne X 3 -> X 57
#        float cutZAtXMax  = 1.10f;   // rezne Z na max X = 1.0 + kliky*0.1
#    Vysledek: 1.10 na X 57, 1.35 uprostred, 1.60 na X 3. Vse nad
#    podlahou clampZ 0.9, viz sekce o ose Z vyse.
#
#    Vyrovnat stul mechanicky je porad lepsi nez kompenzovat softwarem -
#    korekce resi jen naklon roviny, ne prohnuti, a musi se premerit po
#    kazdem zasahu do stolu. Deska je ted na oboustranne pasce, takze
#    podlozit nizky konec par listy papiru je nejlacinejsi zpusob, jak
#    spad zmensit; kazda desetina dolu je desetina, kterou nemusi honit
#    software, a vzdali pasmo Z od te podlahy 0.9.
#
#    JAK TO PREMERIT, at se to nemusi hadat: nastav tiltEnabled = false,
#    najed hrotem na X 3 a sjed Z, dokud se nedotkne medi - zapis si Z.
#    Totez na X 57. Rozdil je tiltDrop, mensi z tech dvou Z patri na max X
#    a je z nej cutZAtXMax. Vetsi Z patri na ten konec, kde je stul VYS.
#
#    pcb2gcode to udelat neumi. Autoleveller (--al-front) sice existuje,
#    ale generuje O-word subrutiny, promenne #, neprime odkazy ## a
#    sondovani G38.2 - tedy program pro interpret, ne G-kod pro stroj.
#    Dekoder v nanoComm vraci na vsechno, co nezacina G nebo M, kod 254,
#    takze by se preskocilo 755 z 813 pohybu a nerezalo by se vubec.
#    Navic sondu nemame a rovinu znames predem, takze mereni za behu
#    nepotrebujeme.
#
#    Korekce proto sedi v gcodeDecoder v nanoComm/main.cpp:
#      - tiltXMin / tiltXMax   souradnice STROJE, ne desky. Korekce je
#                              vlastnost stroje, ne desky - kdyby se brala
#                              z rozsahu nactenoho souboru, dostala by mala
#                              deska uprostred stolu cely spad na par mm.
#      - tiltDrop              o kolik stul klesne mezi temi dvema X
#      - cutZAtXMax            rezne Z na max X, tedy anchor cele primky
#      - cutZForX()            linearni interpolace od anchoru + zaokrouhleni
#                              na cely krok osy Z. Mimo pasmo se X orizne,
#                              takze se nikdy neextrapoluje.
#
#    To zaokrouhleni je nutne. Sklon je 0.0093 mm Z na 1 mm X, takze na
#    beznem segmentu (median 0.23 mm) vyjde zmena Z na necele polovine
#    kroku a firmware ji orizne na nulu. Zmereno na ten.GBL jeste pri
#    starem rozpeti 0.15 mm: bez zaokrouhleni chyba hloubky 0.040 mm
#    (40 % rezu), se zaokrouhlenim prakticky nula. Pri 0.5 mm je ten
#    rozdil umerne vetsi, premereno to nebylo.
#    Patri k tomu i "+ 0.5f" v moveZ() v nanoCode/src/main.cpp - jedno
#    bez druheho nefunguje.

# 9) POMALY POSUV = PRESKOCENE OSY = "SKOK" NA DALSI BOD  [V FIRMWARE]
#    Symptom z testu 13. - 15. 8. 2026: pri pomalem posuvu hrot dojede
#    do bodu A, zavrta se, pohyb na B se neprovede, a nasledujici pohyb
#    "skoci" rovnou na C. Pri rychlem posuvu se to nedeje.
#
#    Neni to vule ani ztracene kroky. Je to move2D() v nanoCode:
#
#        int freqX = int(myCalib.maxStepX / totalTime);
#        if (freqX != 0) { ... setupFreqX(freqX); }
#        ...
#        myToolHead.position.x += (maxStepX / stepLenghtGT2) * copysign(...)
#
#    Po dosazeni totalTime = delka / rychlost a maxStepX = 12.5 * |dx|:
#
#        freqX = 12.5 * rychlost * |dx| / delka
#
#    Kdyz to vyjde pod 1, int() to usekne na 0, setupFreqX se nezavola
#    a osa se VUBEC nerozjede. Pozice se ale pricte tak jako tak, takze
#    firmware si mysli, ze tam dojel. Chyba se neopravi, protoze kazdy
#    dalsi cil se pocita z te nespravne pozice - a hromadi se, dokud
